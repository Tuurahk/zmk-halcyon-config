#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT  0
#define SYM      1
#define FUNCTION 2
#define NAV      3
#define ADJUST   4

/ {
    combos {
        compatible = "zmk,combos";

        CapsLock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <36 51>;
            layers = <0>;
        };

        adjust_layer {
            bindings = <&mo 4>;
            key-positions = <55 25>;
            layers = <0>;
        };

        right_parenthesis {
            bindings = <&kp LS(N8)>;
            key-positions = <27 28>;
            layers = <0>;
        };

        left_parenthesis {
            bindings = <&kp LS(N9)>;
            key-positions = <31 32>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp RA(N7)>;
            key-positions = <39 40>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RA(N0)>;
            key-positions = <47 48>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "Default";

            // ---------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1   |  2  |  3  |  4  |   5   |                               |  6  |  7  |  8  |  9  |  0  | BSPC |
            // |  TAB  |  Q   |  W  |  E  |  R  |   T   |                               |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // |LC(ESC)|  A   |  S  |  D  |  F  |   G   |                               |  H  |  J  |  K  |  L  |  ;  |  '   |
            // |  SHFT |  Z   |  X  |  C  |  V  |   B   | LBKT | CAPS |   | FUNC | RBKT |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                      | ADJ | GUI |LA(ENT)| SPC  | NAV  |   | SYM  | SPC  | ALT | GUI | APP |

            bindings = <
&none       &none  &none  &none  &none     &none                                                        &none     &none  &none      &none    &none     &none
&kp ESCAPE  &kp Q  &kp W  &kp E  &kp R     &kp T                                                        &kp Y     &kp U  &kp I      &kp O    &kp P     &kp BSPC
&mo 3       &kp A  &kp S  &kp D  &kp F     &kp G                                                        &kp H     &kp J  &kp K      &kp L    &kp SEMI  &mt RCTRL SQT
&kp LSHFT   &kp Z  &kp X  &kp C  &kp V     &kp B         &none  &none             &none      &none      &kp N     &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                          &none  &kp LGUI  &mt LALT RET  &mo 1  &kp LEFT_CONTROL  &lt 2 TAB  &kp SPACE  &kp RALT  &mo 3  &none
&none       &none  &none  &none  &none                                                                            &none  &none      &none    &none     &none
            >;
        };

        symbol_layer {
            display-name = "Symbols";

            // -----------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |                           |     |     |     |     |     |     |
            // |  `  |  1  |  2  |  3  |  4  |  5  |                           |  6  |  7  |  8  |  9  |  0  |  =  |
            // |  ~  |  !  |  @  |  #  |  $  |  %  |                           |  ^  |  &  |  *  |  (  |  )  |  +  |
            // | "|" |  \  |  :  |  ;  |  -  |  [  |  {  |     |   |     |  }  |  ]  |  _  |  ,  |  .  |  /  |  ?  |
            //                   |     |     |     |     |     |   |     |     |     |     |     |

            bindings = <
&trans      &trans             &trans         &trans             &trans           &trans                                  &trans            &trans        &trans        &trans        &trans             &trans
&kp LA(F4)  &trans             &trans         &kp RA(E)          &trans           &trans                                  &kp GRAVE         &kp N7        &kp N8        &kp N9        &kp N0             &kp MINUS
&trans      &kp LEFT_GUI       &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &trans                                  &kp LEFT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp RIGHT_BRACKET  &kp EQUAL
&trans      &kp RC(KP_DIVIDE)  &trans         &trans             &trans           &trans  &trans  &trans  &trans  &trans  &kp APOS          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &kp NON_US_BSLH
                                              &trans             &trans           &trans  &trans  &trans  &trans  &trans  &trans            &trans        &trans
&trans      &trans             &trans         &trans             &trans                                                                     &trans        &trans        &trans        &trans             &trans
            >;
        };

        function_layer {
            display-name = "Function";

            // -----------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |                           |     |     |     |     |     |     |
            // |     | F9  | F10 | F11 | F12 |     |                           |     |     |     |     |     |     |
            // |     | F5  | F6  | F7  | F8  |     |                           |     |RSHFT|RCTRL| LALT| RGUI|     |
            // |     | F1  | F2  | F3  | F4  |     |     |     |   |     |     |     |     |     |     |     |     |
            //                   |     |     |     |     |     |   |     |     |     |     |     |

            bindings = <
&trans          &trans  &trans   &trans   &trans   &trans                                  &trans  &trans     &trans     &trans    &trans    &trans
&trans          &kp F9  &kp F10  &kp F11  &kp F12  &trans                                  &trans  &trans     &trans     &trans    &trans    &trans
&trans          &kp F5  &kp F6   &kp F7   &kp F8   &trans                                  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &trans
&studio_unlock  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans    &trans    &trans
                                 &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans
&trans          &trans  &trans   &trans   &trans                                                   &trans     &trans     &trans    &trans    &trans
            >;
        };

        navigation_layer {
            display-name = "Navigation";

            // ------------------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |STDIO|                            |       |      |     |     |       |      |
            // |     |     |     |     |     |     |                            | PG_UP | HOME | UP  | END | VOL_UP| DEL  |
            // |     | GUI | ALT | CTL | SHFT|     |                            | PG_DN | LEFT | DOWN| RGT | VOL_DN| INS  |
            // |     |     |     |     |     |     |     | SLCK |   |     |     | PAUSE | PREV | PLAY| NEXT| MUTE  | PSCRN|
            //                   |     |     |     |     |      |   |     |     |       |      |     |

            bindings = <
&trans  &trans      &trans        &trans        &trans      &trans                                  &trans      &trans      &trans            &trans      &trans      &trans
&trans  &kp K_PREV  &kp K_PP      &kp K_NEXT    &trans      &trans                                  &kp K_CALC  &kp PG_UP   &kp UP            &kp PG_DN   &kp PSCRN   &kp DEL
&trans  &trans      &kp K_VOL_DN  &kp K_VOL_UP  &kp K_MUTE  &trans                                  &kp HOME    &kp LEFT    &kp DOWN          &kp RIGHT   &kp INS     &kp K_VOL_UP
&trans  &trans      &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans  &kp END     &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp K_MUTE  &kp K_VOL_DN
                                  &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans
&trans  &trans      &trans        &trans        &trans                                                          &trans      &trans            &trans      &trans      &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";

            // -----------------------------------------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |                           |       |       |       |       |       |     |
            // | BOOT|     |BTCLR| BT1 | BT2 | BT3 |                           |       |       |       |       |       |BOOT |
            // |     |     |     | BT4 | BT5 |     |                           | RGB_ON|RGB_HUI|RGB_SAI|RGB_BRI|RGB_EFF|     |
            // |     |     |     |     |     |     |     |     |   |     |     |RGB_OFF|RGB_HUD|RGB_SAD|RGB_BRD|RGB_EFR|     |
            //                   |     |     |     |     |     |   |     |     |       |       |       |

            bindings = <
&trans       &trans  &trans      &trans        &trans        &trans                                        &trans           &trans           &trans           &trans           &trans           &trans
&bootloader  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                                  &trans           &trans           &trans           &trans           &trans           &bootloader
&trans       &trans  &trans      &bt BT_SEL 3  &bt BT_SEL 4  &trans                                        &rgb_ug RGB_ON   &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &trans
&trans       &trans  &trans      &trans        &trans        &trans        &trans  &trans  &trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &trans
                                 &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans           &trans           &trans
&trans       &trans  &trans      &trans        &trans                                                                       &trans           &trans           &trans           &trans           &trans
            >;
        };
    };
};
